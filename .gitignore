node_modules/

# manifest.xml is generated from manifest.template.xml by the setup script,
# stamped with the deployer's hosting URL. Don't commit it -- each fork has
# its own.
manifest.xml

# config.js is generated by the setup script with tenant-specific clientId and
# tenantId. These are not secrets (public-client SPA, no client secret), but
# forks that skip setup would silently point at someone else's Entra app
# registration. config.example.js shows the shape; the setup script writes
# the real config.js.
src/config.js
